#
# Generated CMake script for sawIntuitiveResearchKit revision information.
#

set (SAW_INTUITIVE_RESEARCH_KIT_REVISION_DIR "@sawIntuitiveResearchKit_SOURCE_DIR@")
set (SAW_INTUITIVE_RESEARCH_KIT_VERSION "@sawIntuitiveResearchKit_VERSION@")
set (SAW_INTUITIVE_RESEARCH_KIT_REVISION_HEADER_SRC "@SAW_INTUITIVE_RESEARCH_KIT_REVISION_HEADER_SRC@")
set (SAW_INTUITIVE_RESEARCH_KIT_REVISION_HEADER "@SAW_INTUITIVE_RESEARCH_KIT_REVISION_HEADER@")
set (GIT_FOUND @GIT_FOUND@)
set (GIT_EXECUTABLE "@GIT_EXECUTABLE@")

if (GIT_FOUND)
  execute_process (COMMAND ${GIT_EXECUTABLE} describe --always --dirty --long
                   WORKING_DIRECTORY ${SAW_INTUITIVE_RESEARCH_KIT_REVISION_DIR}
                   TIMEOUT 1
                   OUTPUT_VARIABLE SAW_INTUITIVE_RESEARCH_KIT_GIT_DESCRIBE
                   OUTPUT_STRIP_TRAILING_WHITESPACE)
  if (NOT SAW_INTUITIVE_RESEARCH_KIT_GIT_DESCRIBE)
    set (SAW_INTUITIVE_RESEARCH_KIT_GIT_DESCRIBE "git-version-unavailable")
  endif ()
else ()
  set (SAW_INTUITIVE_RESEARCH_KIT_GIT_DESCRIBE "git-version-unavailable")
endif ()

message (STATUS "Found Git revision: ${SAW_INTUITIVE_RESEARCH_KIT_GIT_DESCRIBE}")

configure_file ("${SAW_INTUITIVE_RESEARCH_KIT_REVISION_HEADER_SRC}"
                "${SAW_INTUITIVE_RESEARCH_KIT_REVISION_HEADER}")
